# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
# Copy file ini menjadi .env dan isi dengan token Anda
# Dapatkan dari @BotFather di Telegram

BOT_TOKEN=<PASTE_TOKEN_DARI_BOTFATHER_DI_SINI>
CHAT_ID=<PASTE_CHAT_ID_DARI_USERINFOBOT_DI_SINI>

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# ==========================================
# NODE ENVIRONMENT
# ==========================================
NODE_ENV=development
